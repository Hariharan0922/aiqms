# AiDocMaker Environment Configuration Example
ENVIRONMENT=development
DATABASE_URL=sqlite:///./aiqms.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DEV_AUTH_ENABLED=true

# NVIDIA NIM Hosted API (Primary Document AI Provider)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=poolside/laguna-xs-2.1
NVIDIA_TIMEOUT=120
NVIDIA_MAX_RETRIES=2

# Optional Secondary Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro

MAX_UPLOAD_MB=20
AIQMS_STORAGE_DIR=./data
